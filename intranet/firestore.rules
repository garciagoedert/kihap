rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Models (Engagement & Social Features)
    // ===============================================================
    //
    // Collection: feed/{postId}
    //   - Student updates restricted strictly to `likes` (list<uid>) and/or `reactions` (map<key, list<uid>>).
    //
    // Collection: stories/{storyId}
    //   - Staff-only create/delete; student updates restricted strictly to `reactions`, `pollVotes` (map<uid, optionId>), `viewers` (list<uid> | map<uid, any>).
    //
    // Subcollection: users/{userId}/littles_missions/{weekId}
    //   - Fields: userId, weekId, weekKey, periodKey, characterId, characterName, tasks, completedTaskIds,
    //     completedTasks, checkedIds, doneIds, missions, steps, progress, completed, isCompleted, claimed,
    //     claimedAt, completedAt, notes, parentNote, reflection, createdAt, updatedAt.
    //
    // Collection: achievements_feed/{docId}
    //   - Required: userId (string == auth.uid on create, immutable), type (string), title (string)
    //   - Optional: userName, userPhotoURL, userBelt, unitId, subtitle, icon, metricValue, dedupeKey, reactions (map), createdAt, updatedAt.
    //
    // Collection: weekly_quizzes/{quizId}
    //   - Required: question (string), options (list, 2..8), correctIndex (int)
    //   - Optional: id, explanation, rewardCoins (number 0..500), weekKey, periodKey, active (bool), order, title, category, createdAt, updatedAt, authorId, createdBy.
    //
    // Collection: coin_rewards/{rewardId}
    //   - Required: title (string), cost (number > 0), type (enum)
    //   - Optional: id, description, category ('digital'|'store'), frameId, discountPercent, icon, active (bool), imageUrl, order, createdAt, updatedAt, createdBy.
    //
    // Collection: coin_redemptions/{redemptionId}
    //   - Staff updates restricted strictly to status ('pending'|'delivered'|'cancelled'), deliveredAt (timestamp), deliveredBy (string).
    //
    // Collections written exclusively by Cloud Functions (Admin SDK):
    //   - kihap_cheers/{docId}, streak_duos/{docId}, quiz_attempts/{attemptId},
    //     mission_claims/{claimId}, kihapcoin_transactions/{txId}, workout_feedback/{feedbackId},
    //     copa_unidades_snapshots/{monthId}.
    //
    // ===============================================================
    // Helper Functions & Engagement Validators
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function hasUserFlag(flag) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get(flag, false) == true;
    }

    function isStaffData(d) {
      return d.get('isAdmin', false) == true ||
        d.get('isInstructor', false) == true ||
        d.get('isAdministrativo', false) == true ||
        d.get('isRH', false) == true ||
        d.get('isFinanceiro', false) == true ||
        d.get('isStore', false) == true ||
        d.get('isAcademy', false) == true;
    }

    function isStaff() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        isStaffData(get(/databases/$(database)/documents/users/$(request.auth.uid)).data);
    }

    function isOwnPrefixedId(docId) {
      return isAuthenticated() &&
        docId.size() > request.auth.uid.size() + 1 &&
        docId[0:request.auth.uid.size() + 1] == request.auth.uid + '_';
    }

    function isValidOptionalStr(data, field, maxLen) {
      return !(field in data) ||
        data[field] == null ||
        (data[field] is string && data[field].size() <= maxLen);
    }

    function isValidSelfListToggle(oldVal, newVal, uid, maxSize) {
      let prev = (oldVal is list) ? oldVal : [];
      return newVal is list && newVal.size() <= maxSize && (
        (newVal.hasAll(prev) && newVal.size() <= prev.size() + 1 && newVal.toSet().difference(prev.toSet()).hasOnly([uid])) ||
        (prev.hasAll(newVal) && prev.toSet().difference(newVal.toSet()).hasOnly([uid]))
      );
    }

    function isValidReactionsMapBody(prev, newVal, uid) {
      let allowedKeys = ['kihap', 'fire', 'clap', 'strong', 'heart', 'trophy'];
      let changedKeys = newVal.diff(prev).affectedKeys();
      return newVal.keys().hasOnly(allowedKeys) &&
        changedKeys.size() <= 2 &&
        (!changedKeys.hasAny(['kihap']) || isValidSelfListToggle(prev.get('kihap', []), newVal.get('kihap', []), uid, 10000)) &&
        (!changedKeys.hasAny(['fire']) || isValidSelfListToggle(prev.get('fire', []), newVal.get('fire', []), uid, 10000)) &&
        (!changedKeys.hasAny(['clap']) || isValidSelfListToggle(prev.get('clap', []), newVal.get('clap', []), uid, 10000)) &&
        (!changedKeys.hasAny(['strong']) || isValidSelfListToggle(prev.get('strong', []), newVal.get('strong', []), uid, 10000)) &&
        (!changedKeys.hasAny(['heart']) || isValidSelfListToggle(prev.get('heart', []), newVal.get('heart', []), uid, 10000)) &&
        (!changedKeys.hasAny(['trophy']) || isValidSelfListToggle(prev.get('trophy', []), newVal.get('trophy', []), uid, 10000));
    }

    function isValidReactionsUpdate(oldVal, newVal, uid) {
      let prev = (oldVal is map) ? oldVal : {};
      return newVal is map && isValidReactionsMapBody(prev, newVal, uid);
    }

    function isValidStoryPollVotesMapBody(prev, newVal, uid) {
      let diffKeys = newVal.diff(prev).affectedKeys();
      return newVal.size() <= 10000 &&
        diffKeys.hasOnly([uid]) &&
        uid in newVal &&
        ((newVal[uid] is string && newVal[uid].size() > 0 && newVal[uid].size() <= 64) ||
         (newVal[uid] is int && newVal[uid] >= 0 && newVal[uid] < 20));
    }

    function isValidStoryPollVotesUpdate(oldVal, newVal, uid) {
      let prev = (oldVal is map) ? oldVal : {};
      return newVal is map && isValidStoryPollVotesMapBody(prev, newVal, uid);
    }

    function isValidStoryViewersList(oldVal, newVal, uid) {
      return isValidSelfListToggle(oldVal, newVal, uid, 10000);
    }

    function isValidStoryViewersMap(oldVal, newVal, uid) {
      return newVal is map && newVal.size() <= 10000 && (
        (oldVal is map && newVal.diff(oldVal).affectedKeys().hasOnly([uid])) ||
        (!(oldVal is map) && newVal.keys().hasOnly([uid]))
      );
    }

    function isValidFeedEngagementUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasAny(['likes', 'reactions']) &&
        changed.hasOnly(['likes', 'reactions']) &&
        (!changed.hasAny(['likes']) || (
          'likes' in request.resource.data &&
          isValidSelfListToggle(resource.data.get('likes', []), request.resource.data.likes, request.auth.uid, 10000)
        )) &&
        (!changed.hasAny(['reactions']) || (
          'reactions' in request.resource.data &&
          isValidReactionsUpdate(resource.data.get('reactions', {}), request.resource.data.reactions, request.auth.uid)
        ));
    }

    function isValidStoryEngagementUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasAny(['reactions', 'pollVotes', 'viewers']) &&
        changed.hasOnly(['reactions', 'pollVotes', 'viewers']) &&
        (!changed.hasAny(['reactions']) || (
          'reactions' in request.resource.data &&
          isValidReactionsUpdate(resource.data.get('reactions', {}), request.resource.data.reactions, request.auth.uid)
        )) &&
        (!changed.hasAny(['pollVotes']) || (
          'pollVotes' in request.resource.data &&
          isValidStoryPollVotesUpdate(resource.data.get('pollVotes', {}), request.resource.data.pollVotes, request.auth.uid)
        )) &&
        (!changed.hasAny(['viewers']) || (
          'viewers' in request.resource.data && (
            (request.resource.data.viewers is list && isValidStoryViewersList(resource.data.get('viewers', []), request.resource.data.viewers, request.auth.uid)) ||
            (request.resource.data.viewers is map && isValidStoryViewersMap(resource.data.get('viewers', {}), request.resource.data.viewers, request.auth.uid))
          )
        ));
    }

    function isValidLittlesMissionCollectionField(data, field) {
      return !(field in data) ||
        data[field] == null ||
        ((data[field] is list || data[field] is map) && data[field].size() <= 30);
    }

    function isValidOptionalTimestamp(data, field) {
      return !(field in data) || data[field] == null || data[field] is timestamp;
    }

    function isValidLittlesMission(data, userId) {
      let allowed = [
        'userId', 'weekId', 'weekKey', 'periodKey', 'characterId', 'characterName',
        'tasks', 'completedTaskIds', 'completedTasks', 'checkedIds', 'doneIds',
        'missions', 'steps', 'progress', 'completed', 'isCompleted', 'claimed',
        'claimedAt', 'completedAt', 'notes', 'parentNote', 'reflection',
        'createdAt', 'updatedAt'
      ];
      return data.keys().hasOnly(allowed) &&
        (!('userId' in data) || data.userId == userId) &&
        isValidOptionalStr(data, 'weekId', 40) &&
        isValidOptionalStr(data, 'weekKey', 40) &&
        isValidOptionalStr(data, 'periodKey', 40) &&
        isValidOptionalStr(data, 'characterId', 40) &&
        isValidOptionalStr(data, 'characterName', 80) &&
        isValidOptionalStr(data, 'notes', 1000) &&
        isValidOptionalStr(data, 'parentNote', 1000) &&
        isValidOptionalStr(data, 'reflection', 1000) &&
        (!('completed' in data) || data.completed is bool) &&
        (!('isCompleted' in data) || data.isCompleted is bool) &&
        (!('claimed' in data) || data.claimed is bool) &&
        isValidLittlesMissionCollectionField(data, 'tasks') &&
        isValidLittlesMissionCollectionField(data, 'completedTaskIds') &&
        isValidLittlesMissionCollectionField(data, 'completedTasks') &&
        isValidLittlesMissionCollectionField(data, 'checkedIds') &&
        isValidLittlesMissionCollectionField(data, 'doneIds') &&
        isValidLittlesMissionCollectionField(data, 'missions') &&
        isValidLittlesMissionCollectionField(data, 'steps') &&
        isValidLittlesMissionCollectionField(data, 'progress') &&
        isValidOptionalTimestamp(data, 'createdAt') &&
        isValidOptionalTimestamp(data, 'updatedAt') &&
        isValidOptionalTimestamp(data, 'completedAt') &&
        isValidOptionalTimestamp(data, 'claimedAt');
    }

    function isValidAchievementFeed(data) {
      let allowed = [
        'userId', 'userName', 'userPhotoURL', 'userBelt', 'unitId',
        'type', 'title', 'subtitle', 'icon', 'metricValue',
        'dedupeKey', 'reactions', 'createdAt', 'updatedAt'
      ];
      return data.keys().hasOnly(allowed) &&
        data.keys().hasAll(['userId', 'type', 'title']) &&
        data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
        data.type is string && data.type.size() > 0 && data.type.size() <= 60 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        isValidOptionalStr(data, 'userName', 120) &&
        isValidOptionalStr(data, 'userPhotoURL', 2000) &&
        isValidOptionalStr(data, 'userBelt', 80) &&
        isValidOptionalStr(data, 'unitId', 80) &&
        isValidOptionalStr(data, 'subtitle', 500) &&
        isValidOptionalStr(data, 'icon', 32) &&
        isValidOptionalStr(data, 'metricValue', 80) &&
        isValidOptionalStr(data, 'dedupeKey', 200) &&
        (!('reactions' in data) || (
          data.reactions is map &&
          data.reactions.keys().hasOnly(['kihap', 'fire', 'clap', 'strong', 'heart', 'trophy'])
        )) &&
        (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time + duration.value(5, 'm'))) &&
        isValidOptionalTimestamp(data, 'updatedAt');
    }

    function isValidWeeklyQuiz(data) {
      let allowed = [
        'id', 'question', 'options', 'correctIndex', 'explanation', 'rewardCoins',
        'weekKey', 'periodKey', 'active', 'order', 'title', 'category',
        'createdAt', 'updatedAt', 'authorId', 'createdBy'
      ];
      return data.keys().hasOnly(allowed) &&
        data.keys().hasAll(['question', 'options', 'correctIndex']) &&
        data.question is string && data.question.size() > 0 && data.question.size() <= 1000 &&
        data.options is list && data.options.size() >= 2 && data.options.size() <= 8 &&
        data.correctIndex is int && data.correctIndex >= 0 && data.correctIndex < data.options.size() &&
        isValidOptionalStr(data, 'id', 120) &&
        isValidOptionalStr(data, 'explanation', 2000) &&
        isValidOptionalStr(data, 'weekKey', 40) &&
        isValidOptionalStr(data, 'periodKey', 40) &&
        isValidOptionalStr(data, 'title', 200) &&
        isValidOptionalStr(data, 'category', 80) &&
        isValidOptionalStr(data, 'authorId', 128) &&
        isValidOptionalStr(data, 'createdBy', 128) &&
        (!('rewardCoins' in data) || (data.rewardCoins is number && data.rewardCoins >= 0 && data.rewardCoins <= 500)) &&
        (!('active' in data) || data.active is bool) &&
        (!('order' in data) || (data.order is number && data.order >= 0 && data.order <= 10000)) &&
        isValidOptionalTimestamp(data, 'createdAt') &&
        isValidOptionalTimestamp(data, 'updatedAt');
    }

    function isValidCoinReward(data) {
      let allowed = [
        'id', 'title', 'description', 'cost', 'type', 'category',
        'frameId', 'discountPercent', 'icon', 'active', 'imageUrl',
        'order', 'createdAt', 'updatedAt', 'createdBy'
      ];
      return data.keys().hasOnly(allowed) &&
        data.keys().hasAll(['title', 'cost', 'type']) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 150 &&
        data.cost is number && data.cost > 0 && data.cost <= 100000 &&
        data.type in ['streak_shield', 'avatar_frame', 'littles_pack', 'coupon', 'physical', 'experience'] &&
        isValidOptionalStr(data, 'id', 120) &&
        isValidOptionalStr(data, 'description', 1000) &&
        (!('category' in data) || data.category in ['digital', 'store']) &&
        isValidOptionalStr(data, 'frameId', 60) &&
        (!('discountPercent' in data) || data.discountPercent == null || (data.discountPercent is number && data.discountPercent >= 0 && data.discountPercent <= 100)) &&
        isValidOptionalStr(data, 'icon', 32) &&
        (!('active' in data) || data.active is bool) &&
        isValidOptionalStr(data, 'imageUrl', 2000) &&
        (!('order' in data) || (data.order is number && data.order >= 0 && data.order <= 10000)) &&
        isValidOptionalTimestamp(data, 'createdAt') &&
        isValidOptionalTimestamp(data, 'updatedAt') &&
        isValidOptionalStr(data, 'createdBy', 128);
    }

    function isValidCoinRedemptionUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'deliveredAt', 'deliveredBy']) &&
        'status' in request.resource.data &&
        request.resource.data.status in ['pending', 'delivered', 'cancelled'] &&
        isValidOptionalTimestamp(request.resource.data, 'deliveredAt') &&
        isValidOptionalStr(request.resource.data, 'deliveredBy', 128);
    }

    // Regra para as Contas do Mercado Pago Marketplace
    match /mercadopagoAccounts/{accountId} {
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isStore == true
      );
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Regra para Leads do site
    match /leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    // Regra para o Planificador
    match /plans/{planId} {
      allow read, write: if request.auth != null;
    }

    // Regra para a coleção prospects
    match /prospects/{prospectId} {
      allow read, write: if true;
    }

    // Regra para conversas do WhatsApp
    match /whatsapp_chats/{chatId} {
      allow read, write: if true;
    }

    // Regra para a coleção de Estoque
    match /stock/{stockId} {
      allow read, write: if request.auth != null;
    }

    // Regra para Centros de Distribuição
    match /distribution_centers/{cdId} {
      allow read, write: if request.auth != null;
    }

    // Regra para Histórico de Movimentações de Estoque
    match /stock_movements/{movementId} {
      allow read, write: if request.auth != null;
    }

    // Regra para a coleção de Pedidos de Faixas
    match /pedidosFaixas/{pedidoId} {
      allow read, write: if request.auth != null;
    }

    // Regra para a coleção de Pedidos de Faixas Pretas
    match /pedidosFaixasPretas/{pedidoId} {
      allow read, write: if request.auth != null;
    }

    // Regra para a coleção de Pedidos de Doboks
    match /pedidosDoboks/{pedidoId} {
      allow read, write: if request.auth != null;
    }

    // Regra para a coleção de Processos
    match /processos_articles/{articleId} {
      allow read, write: if request.auth != null;
    }

    // Regra para a coleção de Conteúdos do Tatame
    match /tatame_conteudos/{conteudoId} {
      allow read, write: if request.auth != null;
    }

    // Regra para a coleção de Emblemas (Badges)
    match /badges/{badgeId} {
      allow read, write: if request.auth != null;
    }

    // Regra para a coleção de Eventos do Calendário
    match /events/{eventId} {
      allow read, write: if request.auth != null;
      
      // Regra para a subcoleção de check-ins do evento
      match /checkins/{checkinId} {
        allow read, write: if request.auth != null;
      }
    }

    // Regra para a coleção de Testes Físicos
    match /physicalTests/{testId} {
      allow read, create: if request.auth != null;
      allow update, delete: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isInstructor == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdministrativo == true
      );
    }

    // Regra para Análise de Unidades
    match /analise_unidades/{docId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Regra para Snapshots Diários do EVO
    match /evo_daily_snapshots/{snapshotId} {
      allow read: if request.auth != null;
      allow write: if false; // Apenas o backend (Cloud Functions) pode escrever
    }

    // Regra para Unidades
    match /units/{unitId} {
      allow read: if true;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Regra para Aulas (Grade)
    match /classes/{classId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null; // Permite que usuários autenticados (professores) atualizem a presença
    }

    // Regra para Modelos de Aulas Recorrentes
    match /classTemplates/{templateId} {
      allow read: if true; // Leitura pública para o Miles consultar a grade sem autenticação
      allow write: if request.auth != null;
    }

    // Regra para Instâncias de Aulas (presença)
    match /classInstances/{instanceId} {
      allow read: if true; // Leitura pública para o Miles verificar vagas
      allow write: if request.auth != null;
      // Permite que o Miles (não autenticado) atualize apenas o campo trialStudents
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trialStudents']);
      // Permite que o Miles crie uma nova instância apenas com os campos mínimos (para o primeiro trial)
      allow create: if request.resource.data.keys().hasOnly(['templateId', 'date', 'unitId', 'trialStudents']);
    }

    // Regra existente para prospects
    match /artifacts/{appId}/public/data/prospects/{prospectId} {
      // Permite que qualquer pessoa crie um novo lead (formulário público) e leia a lista de prospects
      allow create, read: if true;
      // Apenas usuários autenticados podem atualizar ou deletar
      allow update, delete: if true;
    }

    // Nova regra para tarefas
    match /artifacts/{appId}/public/data/tasks/{taskId} {
      // Permite que qualquer pessoa crie uma nova tarefa (demanda)
      allow create: if true;
      // Apenas usuários autenticados podem ler, atualizar e apagar tarefas.
      allow read, update, delete: if request.auth != null;
    }

    // Nova regra para reuniões
    // Permite que qualquer usuário autenticado crie, leia, atualize e apague reuniões.
    match /artifacts/{appId}/public/data/meetings/{meetingId} {
      allow read, write: if request.auth != null;
    }

    // Nova regra para eventos
    // Permite que qualquer usuário autenticado crie, leia, atualize e apague eventos.
    match /artifacts/{appId}/public/data/events/{eventId} {
      allow read, write: if request.auth != null;
    }

    // Regra para Mensagens Rápidas
    match /artifacts/{appId}/public/data/mensagens_rapidas/{messageId} {
      allow create, read: if true;
      allow update, delete: if request.auth != null;
    }

    // Regras para Mapas Mentais
    match /artifacts/{appId}/public/data/mind-maps/{mapId} {
      // Permite a um usuário autenticado criar um mapa mental.
      allow create: if request.auth != null;
      // Permite ler, atualizar e deletar apenas se o usuário for o dono do mapa.
      allow read, update, delete: if request.auth != null && resource.data.owner == request.auth.uid;

      // Regras para os nós dentro de um mapa mental
      match /nodes/{nodeId} {
        // Permite criar, ler, atualizar e deletar nós se o usuário for o dono do mapa pai.
        allow read, write: if request.auth != null && get(/databases/$(database)/documents/artifacts/$(appId)/public/data/mind-maps/$(mapId)).data.owner == request.auth.uid;
      }

      // Regras para as conexões dentro de um mapa mental
      match /connections/{connectionId} {
        allow read, write: if request.auth != null && get(/databases/$(database)/documents/artifacts/$(appId)/public/data/mind-maps/$(mapId)).data.owner == request.auth.uid;
      }
    }

    // Regras para Projetos
    match /artifacts/{appId}/public/data/projects/{projectId} {
      // Permite que qualquer usuário autenticado crie e leia projetos.
      allow create, read: if request.auth != null;
      // Permite atualizar e deletar apenas se o usuário for o dono do projeto.
      allow update, delete: if request.auth != null && resource.data.owner == request.auth.uid;

      // Regras para os nós dentro de um projeto
      match /nodes/{nodeId} {
        // Permite que usuários autenticados leiam e escrevam nos nós.
        allow read, write: if request.auth != null;
      }

      // Regras para as conexões (links) dentro de um projeto
      match /links/{linkId} {
        // Permite que usuários autenticados leiam e escrevam nos links.
        allow read, write: if request.auth != null;
      }
    }

    // Regra para a consulta collectionGroup em 'nodes'
    match /{path=**}/nodes/{nodeId} {
      allow read: if request.auth != null;
    }

    // Regras para o chat
    match /chats/{chatId} {
      // Permite criar um chat se o usuário autenticado estiver na lista de membros do novo chat.
      allow create: if request.auth != null && request.auth.uid in request.resource.data.members;
      // Permite ler ou atualizar um chat se o ID do usuário estiver no ID do chat (para DMs) OU se ele for membro (para grupos).
      allow read, update: if request.auth != null && (request.auth.uid in chatId.split('_') || request.auth.uid in resource.data.members);
      // Permite que um membro do chat o delete.
      allow delete: if request.auth != null && request.auth.uid in resource.data.members;
      
      match /messages/{messageId} {
        allow read, create, delete: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
      }
    }

    match /users/{userId} {
      // Permite que qualquer usuário autenticado leia perfis.
      // Permite leitura pública se o usuário for um instrutor (necessário para NPS público).
      allow read: if request.auth != null || resource.data.isInstructor == true;

      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
      allow delete: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;

      // Regra para a subcoleção de testes físicos
      match /physicalTests/{testId} {
        // Permite que um usuário leia/escreva seus próprios testes.
        // Permite que um admin/instrutor/administrativo leia/escreva os testes de qualquer usuário.
        allow read, write: if request.auth.uid == userId || 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isInstructor == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdministrativo == true;
      }

      // Regra para a subcoleção de assinaturas de cursos
      match /subscriptions/{subscriptionId} {
        allow read: if request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
        allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
      }

      // Regra para a subcoleção de Missões Kihap Littles em Casa
      match /littles_missions/{weekId} {
        allow read: if isAuthenticated() && (
          request.auth.uid == userId ||
          hasUserFlag('isAdmin') ||
          hasUserFlag('isInstructor')
        );
        allow create: if isAuthenticated() &&
          weekId.size() > 0 && weekId.size() <= 64 &&
          (
            request.auth.uid == userId ||
            hasUserFlag('isAdmin') ||
            hasUserFlag('isInstructor')
          ) &&
          isValidLittlesMission(request.resource.data, userId);
        allow update: if isAuthenticated() &&
          weekId.size() > 0 && weekId.size() <= 64 &&
          (
            request.auth.uid == userId ||
            hasUserFlag('isAdmin') ||
            hasUserFlag('isInstructor')
          ) &&
          isValidLittlesMission(request.resource.data, userId) &&
          (!('userId' in resource.data) || request.resource.data.get('userId', '') == resource.data.userId) &&
          (!('createdAt' in resource.data) || request.resource.data.get('createdAt', null) == resource.data.createdAt);
        allow delete: if isAuthenticated() && (
          request.auth.uid == userId ||
          hasUserFlag('isAdmin') ||
          hasUserFlag('isInstructor')
        );
      }
    }

    // Regra para a consulta collectionGroup em 'subscriptions'
    match /{path=**}/subscriptions/{subscriptionId} {
      allow read: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Regra para o Feed de Conteúdo
    match /feed/{postId} {
      allow read: if request.auth != null;
      allow create, delete: if isStaff();
      allow update: if isStaff() || (isAuthenticated() && isValidFeedEngagementUpdate());
    }

    // Regra para a coleção de Inscrições de Faixa Preta
    match /inscricoesFaixaPreta/{inscriptionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null; // Qualquer usuário logado pode criar (venda manual)
      allow update, delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true; // Apenas admins podem modificar ou apagar
    }

    // Regra para a coleção de Produtos da Loja
    match /products/{productId} {
      allow read: if resource.data.acessoPublico == true || request.auth != null;
      allow write: if request.auth != null;
    }

    // Regra para Reservas de Assentos do Mapa de Eventos
    match /productSeatReservations/{resId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Regra para a coleção de Banners da Loja
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Regra para a coleção de Cupons da Loja
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // --- REGRAS PARA O SISTEMA DE CURSOS ---

    // As regras abaixo são temporárias para permitir o desenvolvimento.
    // TODO: Implementar autenticação do Firebase e restringir o acesso de escrita
    //       apenas para administradores (ex: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true).

    // Permite a leitura pública das configurações de whitelabel
    match /settings/whitelabel {
      allow read: if true;
      allow write: if request.auth != null; // Apenas usuários logados podem escrever (temporário)
    }

    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Permite a leitura pública de cursos, módulos e aulas
    match /courses/{courseId} {
      allow read: if true;
      allow write: if request.auth != null; // Apenas usuários logados podem escrever (temporário)

      match /modules/{moduleId} {
        allow read: if true;
        allow write: if request.auth != null; // Apenas usuários logados podem escrever (temporário)

        match /lessons/{lessonId} {
          allow read: if true;
          allow write: if request.auth != null; // Apenas usuários logados podem escrever (temporário)
        }
      }
    }

    // Regra para Certificados
    match /certificates/{certificateId} {
      allow read: if true; // Público para validação
      allow write: if request.auth != null; // Apenas usuários logados podem gerar
    }

    // Regra para Configurações (ex: WhatsApp Auto-Reply, social_settings)
    match /config/{configId} {
      allow read: if request.auth != null; // Frontend pode ler (ou webhook via admin SDK ignora regras)
      allow write: if isAuthenticated() &&
        request.resource.data.keys().size() <= 50 && (
          hasUserFlag('isAdmin') ||
          hasUserFlag('isInstructor') ||
          hasUserFlag('isAdministrativo') ||
          (configId == 'social_settings' && hasUserFlag('isMarketing'))
        );
    }

    // Regra para configuração pública do Miles (chave Gemini acessível sem autenticação)
    match /public_config/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Regra para Publicações das Redes Sociais
    match /social_posts/{postId} {
      allow read, write: if request.auth != null;
    }

    // Regra para Logs de Login
    match /login_logs/{logId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null; // Restringir para admins em produção se necessário
    }

    // Regra para Cache de Alunos do EVO (Individual Docs)
    match /evo_students/{studentId} {
      allow read: if request.auth != null;
      allow write: if false; // Apenas Cloud Functions
    }

    // Regra para Status de Sincronização do EVO
    match /evo_sync_status/{unitId} {
      allow read: if request.auth != null;
      allow write: if false; // Apenas Cloud Functions
    }

    // Regra legada para Cache de Alunos do EVO (Bulk Docs)
    match /evo_students_cache/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // Regras para Newsletter
    match /subscribers/{subscriberId} {
      allow read, write: if request.auth != null;
    }

    match /campaigns/{campaignId} {
      allow read, write: if request.auth != null;
    }
    // Regra para Scripts de Atendimento
    match /scripts/{scriptId} {
      allow read, write: if request.auth != null;
    }

    // Regra para Fornecedores
    match /fornecedores/{vendorId} {
      allow read, write: if request.auth != null;
    }

    // Regra para Candidatos RH (Trabalhe Conosco)
    match /rh_prospects/{prospectId} {
      allow create: if true; // Permite que o formulário público crie novos candidatos
      allow read, update, delete: if request.auth != null; // Apenas usuários logados (RH) podem gerenciar
    }

    // Regras para Trello (Marketing)
    match /trello_departments/{deptId} {
      allow read, write: if request.auth != null;
    }

    match /trello_demands/{demandId} {
      allow read, write: if request.auth != null;
      // Subcoleção de Comentários
      match /comments/{commentId} {
        allow read, write: if request.auth != null;
      }
    }

    // Regras para Trello (Jurídico)
    match /juridico_departments/{deptId} {
      allow read, write: if request.auth != null;
    }

    match /juridico_demands/{demandId} {
      allow read, write: if request.auth != null;
      // Subcoleção de Comentários
      match /comments/{commentId} {
        allow read, write: if request.auth != null;
      }
    }

    // Regras para Notificações
    match /notifications/{notificationId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
      );
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null || (
        request.resource.data.type == 'trial' &&
        request.resource.data.read == false
      );
    }

    // Regras para Quotes
    match /daily_quotes/{quoteId} {
      allow read, write: if request.auth != null;
    }

    // Regras para Motivação Diária do Miles (06h)
    match /daily_motivation_recipients/{docId} {
      allow read, write: if request.auth != null;
    }

    // Regra para Organograma
    match /organograma_config/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Regras para NPS (Net Promoter Score)
    match /nps_responses/{responseId} {
      allow create: if true; // Permite submissão pública
      allow read, update, delete: if request.auth != null; // Apenas admin via dashboard
    }

    // Regras para NPS do Experience
    match /experience_nps_responses/{responseId} {
      allow create: if true; // Permite submissão pública
      allow read, update, delete: if request.auth != null; // Apenas admin via dashboard
    }

    // Regras para Campanhas de NPS
    match /nps_campaigns/{campaignId} {
      allow read: if true;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Regras para Seguidores (Follows)
    match /follows/{followId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.followerId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.followerId;
    }

    // Regras para Stories (Kihap Stories)
    // Nota: caso stories de alunos sejam habilitados futuramente via config/social_settings,
    // a regra de create/delete poderá ser expandida para validar config/social_settings + authorId == auth.uid.
    match /stories/{storyId} {
      allow read: if request.auth != null;
      allow create, delete: if isStaff();
      allow update: if isStaff() || (isAuthenticated() && isValidStoryEngagementUpdate());
    }

    // Regras para Banners em Destaque do Feed
    match /banners/{bannerId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isInstructor == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdministrativo == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isRH == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isFinanceiro == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isStore == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAcademy == true
      );
    }

    // Regras para Expansão (Abertura de Novas Unidades)
    match /unit_openings/{openingId} {
      allow read, write: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == 'true'
      );
    }

    // Regras para Métricas e Logs de Acesso do App Mobile
    match /app_access_logs/{logId} {
      allow create: if request.auth != null;
      allow read, delete: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdministrativo == true
      );
    }

    // Regras para Disparos de Notificações Push (Push Notification Center)
    match /push_dispatches/{dispatchId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    // Regras para Configurações do Sistema (ex: Gatilhos Automáticos de Notificação)
    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ===============================================================
    // Regras de Engajamento, Gamificação & Clube de Kihapcoins
    // ===============================================================

    // Mural de Conquistas (Feed da Comunidade)
    match /achievements_feed/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        isValidAchievementFeed(request.resource.data) &&
        (!('reactions' in request.resource.data) || request.resource.data.reactions.size() == 0) &&
        (!('dedupeKey' in request.resource.data) || request.resource.data.dedupeKey == null || request.resource.data.dedupeKey == '' || isOwnPrefixedId(request.resource.data.dedupeKey));
      allow update: if isAuthenticated() &&
        isValidAchievementFeed(request.resource.data) && (
          hasUserFlag('isAdmin') ||
          (
            resource.data.userId == request.auth.uid &&
            request.resource.data.userId == resource.data.userId &&
            (!('createdAt' in resource.data) || request.resource.data.get('createdAt', null) == resource.data.createdAt) &&
            (!('reactions' in request.resource.data) || isValidReactionsUpdate(resource.data.get('reactions', {}), request.resource.data.reactions, request.auth.uid))
          ) ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']) &&
            'reactions' in request.resource.data &&
            isValidReactionsUpdate(resource.data.get('reactions', {}), request.resource.data.reactions, request.auth.uid)
          )
        );
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        hasUserFlag('isAdmin') ||
        hasUserFlag('isInstructor')
      );
    }

    // Kihaps & Incentivos de Chama (escrito exclusivamente via Cloud Function Admin SDK)
    match /kihap_cheers/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Ofensiva em Dupla / Família ("Parceiro de Tatame" - escrito exclusivamente via Cloud Function)
    match /streak_duos/{docId} {
      allow list: if isAuthenticated() && (
        request.auth.uid in resource.data.memberIds ||
        hasUserFlag('isAdmin')
      );
      allow get: if isAuthenticated() && (
        resource == null
          ? (request.auth.uid in docId.split('_') || isOwnPrefixedId(docId) || hasUserFlag('isAdmin'))
          : (request.auth.uid in resource.data.memberIds || hasUserFlag('isAdmin'))
      );
      allow write: if false;
    }

    // Quiz Semanal do Tatame
    match /weekly_quizzes/{quizId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (
        hasUserFlag('isAdmin') ||
        hasUserFlag('isInstructor') ||
        hasUserFlag('isAdministrativo') ||
        hasUserFlag('isAcademy')
      ) && isValidWeeklyQuiz(request.resource.data);
      allow delete: if isAuthenticated() && (
        hasUserFlag('isAdmin') ||
        hasUserFlag('isInstructor') ||
        hasUserFlag('isAdministrativo') ||
        hasUserFlag('isAcademy')
      );
    }

    // Tentativas de Quiz Semanal (escrito exclusivamente via Cloud Function)
    match /quiz_attempts/{attemptId} {
      allow list: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        hasUserFlag('isAdmin')
      );
      allow get: if isAuthenticated() && (
        resource == null
          ? (isOwnPrefixedId(attemptId) || hasUserFlag('isAdmin'))
          : (resource.data.userId == request.auth.uid || hasUserFlag('isAdmin'))
      );
      allow write: if false;
    }

    // Resgates Idempotentes de Missões (escrito exclusivamente via Cloud Function)
    match /mission_claims/{claimId} {
      allow list: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        hasUserFlag('isAdmin')
      );
      allow get: if isAuthenticated() && (
        resource == null
          ? (isOwnPrefixedId(claimId) || hasUserFlag('isAdmin'))
          : (resource.data.userId == request.auth.uid || hasUserFlag('isAdmin'))
      );
      allow write: if false;
    }

    // Extrato de Kihapcoins (escrito exclusivamente via Cloud Function)
    match /kihapcoin_transactions/{txId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        hasUserFlag('isAdmin')
      );
      allow write: if false;
    }

    // Catálogo de Recompensas do Clube de Kihapcoins
    match /coin_rewards/{rewardId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (
        hasUserFlag('isAdmin') ||
        hasUserFlag('isAdministrativo') ||
        hasUserFlag('isStore')
      ) && isValidCoinReward(request.resource.data);
      allow delete: if isAuthenticated() && (
        hasUserFlag('isAdmin') ||
        hasUserFlag('isAdministrativo') ||
        hasUserFlag('isStore')
      );
    }

    // Resgates de Recompensas (criado/removido apenas via Cloud Function; entrega marcada pela equipe)
    match /coin_redemptions/{redemptionId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        hasUserFlag('isAdmin') ||
        hasUserFlag('isInstructor') ||
        hasUserFlag('isAdministrativo') ||
        hasUserFlag('isStore')
      );
      allow create, delete: if false;
      allow update: if isAuthenticated() && (
        hasUserFlag('isAdmin') ||
        hasUserFlag('isInstructor') ||
        hasUserFlag('isAdministrativo') ||
        hasUserFlag('isStore')
      ) && isValidCoinRedemptionUpdate();
    }

    // Termômetro Pós-Treino (escrito exclusivamente via Cloud Function)
    match /workout_feedback/{feedbackId} {
      allow list: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        hasUserFlag('isAdmin') ||
        hasUserFlag('isInstructor') ||
        hasUserFlag('isAdministrativo') ||
        hasUserFlag('isAcademy')
      );
      allow get: if isAuthenticated() && (
        resource == null
          ? (
              isOwnPrefixedId(feedbackId) ||
              hasUserFlag('isAdmin') ||
              hasUserFlag('isInstructor') ||
              hasUserFlag('isAdministrativo') ||
              hasUserFlag('isAcademy')
            )
          : (
              resource.data.userId == request.auth.uid ||
              hasUserFlag('isAdmin') ||
              hasUserFlag('isInstructor') ||
              hasUserFlag('isAdministrativo') ||
              hasUserFlag('isAcademy')
            )
      );
      allow write: if false;
    }

    // Snapshots Mensais da Copa das Unidades (escrito exclusivamente via Cloud Function)
    match /copa_unidades_snapshots/{monthId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
  }
}

