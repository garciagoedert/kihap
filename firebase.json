{
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "android/**",
      "ios/**",
      "native/**",
      "functions/**",
      "www_legacy/**",
      "desenvolvimento/**"
    ],
    "rewrites": [
      {
        "source": "/interatividade",
        "destination": "/interatividade/index.html"
      },
      {
        "source": "/interatividade/torcida",
        "destination": "/interatividade/torcida.html"
      },
      {
        "source": "/:path((?!.*\\.).*)",
        "destination": "/:path.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  },
  "functions": {
    "source": "functions",
    "cors": "cors.json"
  },
  "firestore": {
    "rules": "intranet/firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "hosting": {
      "port": 8000
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true
  }
}
